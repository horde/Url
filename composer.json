{
    "name": "horde/url",
    "description": "URL library",
    "type": "library",
    "homepage": "https://www.horde.org/libraries/Horde_Url",
    "license": "LGPL-2.1-only",
    "authors": [
        {
            "name": "Jan Schneider",
            "email": "jan@horde.org",
            "role": "lead"
        },
        {
            "name": "Michael Slusarz",
            "email": "slusarz@horde.org",
            "role": "lead"
        }
    ],
    "time": "2026-03-15",
    "repositories": [],
    "require": {
        "php": "^8.1",
        "horde/exception": "^3 || dev-FRAMEWORK_6_0"
    },
    "require-dev": {},
    "suggest": {
        "horde/test": "^3 || dev-FRAMEWORK_6_0",
        "phpunit/phpunit": "^11 || ^12",
        "horde/http": "^3 || dev-FRAMEWORK_6_0",
        "psr/http-message": "For PSR-7 interoperability via Psr7Bridge"
    },
    "autoload": {
        "psr-0": {
            "Horde_Url": "lib/"
        },
        "psr-4": {
            "Horde\\Url\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\Url\\Test\\": "test/"
        }
    },
    "config": {
        "allow-plugins": {}
    },
    "extra": {
        "branch-alias": {
            "dev-FRAMEWORK_6_0": "3.x-dev"
        }
    }
}